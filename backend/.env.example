# ===== Banco de dados PostgreSQL (Easypanel / Hostinger VPS) =====
# No Easypanel, ao criar o serviço Postgres, use os dados internos do serviço.
DB_HOST=meu-lava-rapido-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_NAME=meulavarapido
# Alternativa: string única (tem prioridade se preenchida)
# DATABASE_URL=postgres://postgres:senha@host:5432/meulavarapido
DB_SSL=false

# ===== Autenticação =====
# Gere uma chave longa e aleatória (ex.: openssl rand -hex 32)
JWT_SECRET=troque-por-uma-chave-secreta-bem-longa-e-aleatoria
JWT_EXPIRES_IN=30d

# ===== Servidor =====
PORT=3000
# IMPORTANTE: defina como "production" no EasyPanel para bloquear ativação manual de premium.
NODE_ENV=production

# ===== Validação de assinatura (opcional, fase 2) =====
# Segredo compartilhado para o webhook do RevenueCat.
REVENUECAT_WEBHOOK_SECRET=

# ===== Verificação de telefone (Firebase Phone Auth) =====
# Service account do projeto Firebase (Console > Configurações > Contas de serviço).
# Sem estas variáveis, o cadastro funciona em modo dev (telefone NÃO verificado).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole a chave privada com \n escapados, entre aspas. Ex.: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# ===== Contato do desenvolvedor (tela "Contate o desenvolvedor" no app) =====
# Exibidos no app via GET /api/support/contact. Não há valor de e-mail embutido
# no código: se SUPPORT_EMAIL ficar vazio, o app não mostra o link de e-mail.
SUPPORT_NAME=Studio Mythos
SUPPORT_EMAIL=almir.seibert@gmail.com
# Opcional, somente dígitos com DDI. Ex.: 5551999999999
SUPPORT_WHATSAPP=

# ===== Notificações push (novidades e promoções) =====
# E-mails autorizados a abrir a "Central de novidades" no app e disparar avisos.
# Separe por vírgula. Sem esta variável, ninguém vê nem envia.
ADMIN_EMAILS=
# Opcional: token de acesso do Expo (Expo > Access tokens). Recomendado em produção
# para o serviço de push aceitar volumes maiores sem limitação.
EXPO_ACCESS_TOKEN=
