# ===== Banco de dados PostgreSQL (Easypanel / Hostinger VPS) =====
# No Easypanel, ao criar o serviço Postgres, use os dados internos do serviço.
DB_HOST=meu-lava-rapido-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_NAME=meulavarapido
# Alternativa: string única (tem prioridade se preenchida)
# DATABASE_URL=postgres://postgres:senha@host:5432/meulavarapido
DB_SSL=false

# ===== Autenticação =====
# Gere uma chave longa e aleatória (ex.: openssl rand -hex 32)
JWT_SECRET=troque-por-uma-chave-secreta-bem-longa-e-aleatoria
JWT_EXPIRES_IN=30d

# ===== Servidor =====
PORT=3000
# IMPORTANTE: defina como "production" no EasyPanel para bloquear ativação manual de premium.
NODE_ENV=production

# ===== Assinatura premium (RevenueCat) — OBRIGATÓRIO em produção =====
# Chave SECRETA v1 do projeto (RevenueCat > Project settings > API keys >
# Secret key, começa com "sk_"). É o que permite ao backend confirmar a compra
# em POST /api/subscription/sync e liberar o premium na hora, sem depender do
# webhook. SEM esta chave, quem pagar continua sem acesso até o webhook chegar.
# Nunca use aqui a chave pública do app (goog_... / appl_...).
REVENUECAT_API_KEY=
# Nome do entitlement configurado no RevenueCat (padrão: premium).
REVENUECAT_ENTITLEMENT=premium
# Segredo do webhook. Cole EXATAMENTE o mesmo valor no campo "Authorization"
# em RevenueCat > Integrations > Webhooks (com ou sem o prefixo "Bearer ").
# Em produção o webhook é RECUSADO se esta variável estiver vazia.
# Use apenas letras e números (ex.: openssl rand -hex 32): caracteres como
# # & $ ! quebram o valor quando ele passa por arquivo .env ou pelo shell.
REVENUECAT_WEBHOOK_SECRET=

# ===== Verificação de telefone (Firebase Phone Auth) =====
# Service account do projeto Firebase (Console > Configurações > Contas de serviço).
# Sem estas variáveis, o cadastro funciona em modo dev (telefone NÃO verificado).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole a chave privada com \n escapados, entre aspas. Ex.: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# ===== Teste grátis (14 dias) =====
# Sal do HMAC que identifica, sem guardar o número, quais telefones já usaram o
# teste grátis (tabela trial_phones). Serve para que excluir a conta no app não
# devolva um novo período de 14 dias.
# Gere uma vez (openssl rand -hex 32) e NUNCA mude: trocar o sal torna os
# hashes antigos irreconhecíveis e libera o teste de novo para quem já usou.
# Se ficar vazio, o JWT_SECRET é usado como sal — então trocar o JWT_SECRET
# teria o mesmo efeito colateral. Prefira definir esta variável.
TRIAL_PHONE_SALT=

# ===== Contato do desenvolvedor (tela "Contate o desenvolvedor" no app) =====
# Exibidos no app via GET /api/support/contact. Não há valor de e-mail embutido
# no código: se SUPPORT_EMAIL ficar vazio, o app não mostra o link de e-mail.
SUPPORT_NAME=Studio Mythos
SUPPORT_EMAIL=almir.seibert@gmail.com
# Opcional, somente dígitos com DDI. Ex.: 5551999999999
SUPPORT_WHATSAPP=

# ===== Notificações push (novidades e promoções) =====
# E-mails autorizados a abrir a "Central de novidades" no app e disparar avisos.
# Separe por vírgula. Sem esta variável, ninguém vê nem envia.
ADMIN_EMAILS=
# Opcional: token de acesso do Expo (Expo > Access tokens). Recomendado em produção
# para o serviço de push aceitar volumes maiores sem limitação.
EXPO_ACCESS_TOKEN=
